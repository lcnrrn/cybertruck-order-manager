const { snapshotPrices, autoOrderAmount, LEGACY_PRICE_CUTOFF } = await import('../src/production.ts');
const { buildCatalog } = await import('../src/buyer/config.ts');
const ok = (n: string, c: boolean) => { console.log(c ? 'PASS' : 'FAIL', n); if (!c) process.exit(1); };
const C = (o: Record<string, number>) => Object.entries(o).map(([name, price]) => ({ name, price, color: { bg: '', border: '', text: '' } }));
const BELT = '안전벨트 클립 (뒷자석 3개)';
const cat = C({ [BELT]: 7000, '비스트 앰블럼': 5000, '우체국 택배': 4500 });
const oldO = { items: `${BELT} x2 / 비스트 앰블럼 / 우체국 택배`, createdAt: LEGACY_PRICE_CUTOFF - 1000 };
const p = snapshotPrices(oldO, cat)!;
ok('old order keeps old belt price', p[BELT] === 5000 && p['비스트 앰블럼'] === 5000 && p['우체국 택배'] === 4500);
ok('old total uses old price', autoOrderAmount({ ...oldO, prices: p }, cat) === 5000 * 2 + 5000 + 4500);
const newO = { items: `${BELT}`, createdAt: LEGACY_PRICE_CUTOFF + 1000 };
ok('new order gets new price', snapshotPrices(newO, cat)![BELT] === 7000);
ok('later price change does not affect snapshotted', autoOrderAmount({ ...oldO, prices: p }, C({ [BELT]: 9000, '비스트 앰블럼': 9000, '우체국 택배': 9000 })) === 19500);
ok('idempotent', snapshotPrices({ ...oldO, prices: p }, cat) === null);
ok('service 0 kept', snapshotPrices({ items: '비스트 앰블럼', createdAt: 0, prices: { '비스트 앰블럼': 0 } }, cat) === null);
ok('unknown price not frozen', snapshotPrices({ items: '비스트 앰블럼', createdAt: Date.now() }, C({ '비스트 앰블럼': 0 })) === null);
const b = buildCatalog([{ name: '휴대폰 마운트 거치대', price: 13000 }, { name: 'DC콤보+J1772 거치대', price: 25000 }, { name: BELT, price: 7000 }, { name: '스타링크 거치대', price: 15000 }, { name: '기타', price: 1 }, { name: '우체국 택배', price: 5000 }]);
const names = b.groups.flatMap((g) => g.options.map((o) => o.name));
ok('buyer list follows app', names.join('|') === `휴대폰 마운트 거치대|DC콤보+J1772 거치대|${BELT}|스타링크 거치대`);
ok('buyer price live', b.groups.flatMap((g) => g.options).find((o) => o.name === BELT)!.price === 7000 && b.shipping.price === 5000);
ok('fallback', buildCatalog(null).groups.length > 5);
